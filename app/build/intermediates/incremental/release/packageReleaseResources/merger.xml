 את הזמנים.</string><string name="msg_no_internet">אין חיבור לאינטרנט.</string><string name="action_retry">נסה שוב</string><string name="action_refresh">רענן</string><string name="title_settings">הגדרות</string><string name="settings_language">שפה</string><string name="settings_location_source">מקור מיקום</string><string name="settings_in_israel">בישראל</string><string name="settings_in_israel_desc">החל מנהגים הלכתיים של ארץ ישראל</string><string name="lang_system">ברירת מחדל של המערכת</string><string name="lang_english">English</string><string name="lang_hebrew">עברית</string><string name="loc_source_gps">GPS (מיקום המכשיר)</string><string name="loc_source_manual">ידני</string><string name="action_change_location">שנה מיקום</string><string name="settings_manual_place_header">בחר את המיקום שלך</string><string name="settings_manual_current">נוכחי: %1$s</string><string name="settings_manual_none">לא נבחר מיקום</string><string name="msg_searching">מחפש…</string><string name="settings_calc_method">חישוב נץ</string><string name="calc_local_mishor">נץ המישור (גובה פני הים) — מקומי</string><string name="calc_local_nireh">נץ הנראה (אופק ים) — מקומי</string><string name="calc_hebcal_mishor">Hebcal מישור (אונליין)</string><string name="calc_local_mishor_desc">נץ גיאומטרי בגובה פני הים כולל שבירה אטמוספרית. מחושב במכשיר.</string><string name="calc_local_nireh_desc">נץ הנראה מהגובה שלך לכיוון אופק הים — מוקדם יותר בגבהים. לא לוקח בחשבון טופוגרפיה (הרים). משתמש בגובה ה-GPS כשאפשר, אחרת 0 מ׳.</string><string name="calc_hebcal_mishor_desc">נץ בגובה פני הים מאתר hebcal.com (דורש אינטרנט, נשמר במטמון לפי יום).</string><string name="action_about_calc">אודות החישוב</string><string name="about_title">אודות החישוב</string><string name="about_intro_h">מהו נץ החמה?</string><string name="about_intro_b">נץ החמה הוא הרגע ההלכתי של זריחה. שיטות שונות מחשבות אותו בדרכים שונות — לפי האם מרכז השמש או קצה השמש חוצים את האופק, האם נכללת שבירה אטמוספרית, האם הצופה בגובה פני הים או בגובה רב, והאם האופק המזרחי הוא אופק הים הגיאומטרי או טופוגרפיה מקומית אמיתית.</string><string name="about_methods_h">שלוש האפשרויות באפליקציה</string><string name="about_mishor_h">מישור (גובה פני הים) — מקומי</string><string name="about_mishor_b">זריחה בגובה פני הים כולל שבירה אטמוספרית, מחושבת מקומית באמצעות ספריית KosherJava (אלגוריתם השמש של NOAA). שווה ערך לרוב ערכי ה-sunrise המפורסמים עבור צופה בגובה פני הים. זהה לערך ה-sunrise של Hebcal.</string><string name="about_nireh_h">הנראה (אופק ים) — מקומי</string><string name="about_nireh_b">נץ הנראה מהגובה שלך, כשמסתכלים לאופק ים. מוקדם יותר ממישור כשאתה בגובה (פונקציית getSunrise של KosherJava עם גובה ה-GPS של המכשיר). <b>חשוב:</b> חישוב זה אינו מתחשב בטופוגרפיה המזרחית האמיתית. הוא מניח שהאופק המזרחי הוא הים — נכון עבור צופים בחוף, אך לא מדויק בפנים הארץ במקומות שבהם הרים חוסמים את השמש. לדוגמה, בירושלים הר הזיתים מעכב את הזריחה הנראית; חישוב זה אינו מביא זאת בחשבון.</string><string name="about_hebcal_h">Hebcal מישור — אונליין</string><string name="about_hebcal_b">זריחה בגובה פני הים מ-API ציבורי של hebcal.com. שווה מספרית למישור המקומי (Hebcal לא תומך בגובה). שימושי כבדיקה צולבת או למשתמשים שמעדיפים להתאים לערך שמפורסם ב-Hebcal.</string><string name="about_caveat_h">למה לא אותו ערך כמו chaitables / לוח מודפס?</string><string name="about_caveat_b">לוחות מודפסים כמו של לוחות חי משתמשים ב<b>אופק הטופוגרפי המזרחי האמיתי</b> — ההרים, הגבעות או הבניינים שחוסמים את השמש המוקדמת. זה מידע מקומי ספציפי שאיננו מודלים כרגע במכשיר. אפשרות עתידית תאפשר להעלות טבלה מותאמת אישית למקום שלך כך שהספירה תתאים ללוח המקומי שלך בדיוק.</string><string name="title_tfila">ציוני דרך בתפילה</string><string name="settings_tfila_desc">הפרשים (דקות) לפני הנץ</string><string name="milestone_hodu">הודו</string><string name="milestone_baruch_sheamar">ברוך שאמר</string><string name="milestone_vayivarech_david">ויברך דוד</string><string name="milestone_yishtabach">ישתבח</string><string name="milestone_kadosh">קדוש</string><string name="milestone_shema">שמע ישראל</string><string name="milestone_emet">אמת</string><string name="milestone_ezrat_avotenu">עזרת אבותנו</string><string name="milestone_tehilot">תהילות</string><string name="milestone_amida">עמידה</string><string name="msg_error_chronological">ציוני הדרך חייבים להיות בסדר כרונולוגי (מספר דקות יורד).</string><string name="hint_minutes">דקות לפני הנץ</string><string name="action_save">שמור</string><string name="cd_settings">פתח הגדרות</string><string name="cd_refresh">רענן זמנים</string></file><file name="ic_launcher" path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/main/res/mipmap-xhdpi/ic_launcher.webp" qualifiers="xhdpi-v4" type="mipmap"/><file name="ic_launcher_round" path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/main/res/mipmap-xhdpi/ic_launcher_round.webp" qualifiers="xhdpi-v4" type="mipmap"/><file name="ic_launcher" path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/main/res/mipmap-anydpi/ic_launcher.xml" qualifiers="anydpi-v4" type="mipmap"/><file name="ic_launcher_round" path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/main/res/mipmap-anydpi/ic_launcher_round.xml" qualifiers="anydpi-v4" type="mipmap"/></source></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="release$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/release/res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="release" generated-set="release$Generated" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~:!&lt;dir>navigation"><source path="/Users/michaelatlan/AndroidStudioProjects/Netzv2/app/src/release/res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="generated$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!th