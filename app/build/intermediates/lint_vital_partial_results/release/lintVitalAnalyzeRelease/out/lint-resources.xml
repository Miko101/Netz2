ctivity_tfila_settings,16,F;row_setting,13,F;activity_settings,17,F;row_kv,18,F;row_tfila_input,21,F;+mipmap:ic_launcher_round,23,F;ic_launcher_round,24,F;ic_launcher_round,25,F;ic_launcher_round,26,F;ic_launcher_round,27,F;ic_launcher_round,28,F;ic_launcher,29,F;ic_launcher,30,F;ic_launcher,31,F;ic_launcher,32,F;ic_launcher,33,F;ic_launcher,34,F;+string:title_tfila,35,V4005618ce,3800561902,;"Tfila Milestones";title_tfila,36,V400511579,38005115ad,;"ציוני דרך בתפילה";about_caveat_b,35,V400531716,19b005318ad,;"Printed luchot from sources like חיים שכטר or לוחות חי use the actual eastern topographic horizon — the mountains\, hills\, or buildings that block the early sun. This is locality-specific data that we don't currently model on-device. A planned future option will let you upload a custom table for your locality so the countdown matches your local luach exactly."Printed luchot from sources like חיים שכטר or לוחות חי use the <b>actual eastern topographic horizon</b> — the mountains\, hills\, or buildings that block the early sun. This is locality-specific data that we don\\'t currently model on-device. A planned future option will let you upload a custom table for your locality so the countdown matches your local luach exactly.;about_caveat_b,36,V4004f143e,139004f1573,;"לוחות מודפסים כמו של לוחות חי משתמשים באופק הטופוגרפי המזרחי האמיתי — ההרים\, הגבעות או הבניינים שחוסמים את השמש המוקדמת. זה מידע מקומי ספציפי שאיננו מודלים כרגע במכשיר. אפשרות עתידית תאפשר להעלות טבלה מותאמת אישית למקום שלך כך שהספירה תתאים ללוח המקומי שלך בדיוק."לוחות מודפסים כמו של לוחות חי משתמשים ב<b>אופק הטופוגרפי המזרחי האמיתי</b> — ההרים\, הגבעות או הבניינים שחוסמים את השמש המוקדמת. זה מידע מקומי ספציפי שאיננו מודלים כרגע במכשיר. אפשרות עתידית תאפשר להעלות טבלה מותאמת אישית למקום שלך כך שהספירה תתאים ללוח המקומי שלך בדיוק.;zman_mincha_gedola,35,V4001002eb,3c00100323,;"Mincha Gedola";zman_mincha_gedola,36,V4000e026c,39000e02a1,;"מנחה גדולה";milestone_yishtabach,35,V4005b1a11,3b005b1a48,;"Yishtabach";milestone_yishtabach,36,V4005616a9,36005616db,;"ישתבח";settings_location_source,35,V4002b08cc,44002b090c,;"Location source";settings_location_source,36,V4002707cc,3f00270807,;"מקור מיקום";action_save,35,V400641c44,2c00641c6c,;"Save";action_save,36,V4005f18c2,2c005f18ea,;"שמור";lang_hebrew,35,V400300a19,2d00300a42,;"עברית";lang_hebrew,36,V4002c0904,2d002c092d,;"עברית";title_netz_hahama,35,V40004005b,3a00040091,;"Netz HaChama";title_netz_hahama,36,V40003003e,350003006f,;"נץ החמה";indicator_offline,35,V4000a01a6,4b000a01ed,;"Offline — showing cached data";indicator_offline,36,V400090176,4b000901bd,;"לא מקוון — מציג נתונים שמורים";msg_error_chronological,35,V400621b94,7500621c05,;"Milestones must be in chronological order (higher minutes first).";msg_error_chronological,36,V4005d181e,6c005d1886,;"ציוני הדרך חייבים להיות בסדר כרונולוגי (מספר דקות יורד).";zman_chatzot,35,V4000f02ba,30000f02e6,;"Chatzot";zman_chatzot,36,V4000d023e,2d000d0267,;"חצות";about_mishor_h,35,V4004911b7,49004911fc,;"Mishor (sea-level) — on device";about_mishor_h,36,V400450fa4,4700450fe7,;"מישור (גובה פני הים) — מקומי";about_intro_h,35,V400440fa1,3f00440fdc,;"What is Netz HaChama?";about_intro_h,36,V400400e00,3600400e32,;"מהו נץ החמה?";about_mishor_b,35,V4004a1201,10c004a1309,;"Sea-level sunrise with atmospheric refraction\, computed locally via the KosherJava library (NOAA solar algorithm). Equivalent to most published sunrisevalues for an observer at sea level. Same as Hebcal's sunrisefield.";about_mishor_b,36,V400460fec,f3004610db,;"זריחה בגובה פני הים כולל שבירה אטמוספרית\, מחושבת מקומית באמצעות ספריית KosherJava (אלגוריתם השמש של NOAA). שווה ערך לרוב ערכי ה-sunrise המפורסמים עבור צופה בגובה פני הים. זהה לערך ה-sunrise של Hebcal.";settings_manual_place_header,35,V400340b00,4d00340b49,;"Choose your location";settings_manual_place_header,36,V4003009e0,4a00300a26,;"בחר את המיקום שלך";about_caveat_h,35,V4005216bb,5a00521711,;"Why not the same as chaitables / printed luach?";about_caveat_h,36,V4004e13e7,56004e1439,;"למה לא אותו ערך כמו chaitables / לוח מודפס?";post_day_label,35,V400170438,360017046a,;"Day is done";post_day_label,36,V4001503ab,36001503dd,;"היום הסתיים";about_methods_h,35,V40047116c,49004711b1,;"The three options in this app";about_methods_h,36,V400430f5e,4400430f9e,;"שלוש האפשרויות באפליקציה";calc_hebcal_mishor_desc,35,V4003f0ea2,7a003f0f18,;"Sea-level sunrise from hebcal.com (requires internet\, cached per day).";calc_hebcal_mishor_desc,36,V4003b0d14,79003b0d89,;"נץ בגובה פני הים מאתר hebcal.com (דורש אינטרנט\, נשמר במטמון לפי יום).";calc_hebcal_mishor,35,V4003c0cec,45003c0d2d,;"Hebcal Mishor (online)";calc_hebcal_mishor,36,V400380bac,4500380bed,;"Hebcal מישור (אונליין)";cd_refresh,35,V400681cba,3500681ceb,;"Refresh zmanim";cd_refresh,36,V400621923,3100621950,;"רענן זמנים";action_about_calc,35,V400410f1e,4300410f5d,;"About the calculation";action_about_calc,36,V4003d0d8f,3a003d0dc5,;"אודות החישוב";milestone_shema,35,V4005d1a81,38005d1ab5,;"Shema Israel";milestone_shema,36,V400581712,3500581743,;"שמע ישראל";label_next_netz,35,V400050096,40000500d2,;"Next Netz HaChama in";label_next_netz,36,V400040074,3c000400ac,;"נץ החמה הבא בעוד";action_search,35,V4001e05b9,30001e05e5,;"Search";action_search,36,V4001b04ef,2d001b0518,;"חפש";zman_plag_hamincha,35,V400120365,3c0012039d,;"Plag HaMincha";zman_plag_hamincha,36,V4001002df,3800100313,;"פלג המנחה";netz_passed_short,35,V40007010c,3d00070145,;"Netz has passed";netz_passed_short,36,V4000600e3,3900060118,;"נץ החמה עבר";msg_searching,35,V400370bd8,3400370c08,;"Searching…";msg_searching,36,V400330aaa,2f00330ad5,;"מחפש…";milestone_vayivarech_david,35,V4005a19c9,47005a1a0c,;"Vayivarech David";milestone_vayivarech_david,36,V400551668,40005516a4,;"ויברך דוד";about_nireh_b,35,V4004d135b,214004d156b,;"Visible sunrise from your elevation\, looking out at a sea horizon. Earlier than Mishor when you're at altitude (KosherJava's getSunrise() with the device's GPS altitude). Important\: this does NOT model the actual eastern terrain. It assumes the eastern horizon is the ocean — true for coastal observers\, but inaccurate inland where mountains block the sun. For example\, in Jerusalem the Mount of Olives delays the truly visible sunrise\; this calculation does not account for that."Visible sunrise from your elevation\, looking out at a sea horizon. Earlier than Mishor when you\\'re at altitude (KosherJava\\'s getSunrise() with the device\\'s GPS altitude). <b>Important\:</b> this does NOT model the actual eastern terrain. It assumes the eastern horizon is the ocean — true for coastal observers\, but inaccurate inland where mountains block the sun. For example\, in Jerusalem the Mount of Olives delays the truly visible sunrise\; this calculation does not account for that.;about_nireh_b,36,V400491123,1ab004912ca,;"נץ הנראה מהגובה שלך\, כשמסתכלים לאופק ים. מוקדם יותר ממישור כשאתה בגובה (פונקציית getSunrise של KosherJava עם גובה ה-GPS של המכשיר). חשוב\: חישוב זה אינו מתחשב בטופוגרפיה המזרחית האמיתית. הוא מניח שהאופק המזרחי הוא הים — נכון עבור צופים בחוף\, אך לא מדויק בפנים הארץ במקומות שבהם הרים חוסמים את השמש. לדוגמה\, בירושלים הר הזיתים מעכב את הזריחה הנראית\; חישוב זה אינו מביא זאת בחשבון."נץ הנראה מהגובה שלך\, כשמסתכלים לאופק ים. מוקדם יותר ממישור כשאתה בגובה (פונקציית getSunrise של KosherJava עם גובה ה-GPS של המכשיר). <b>חשוב\:</b> חישוב זה אינו מתחשב בטופוגרפיה המזרחית האמיתית. הוא מניח שהאופק המזרחי הוא הים — נכון עבור צופים בחוף\, אך לא מדויק בפנים הארץ במקומות שבהם הרים חוסמים את השמש. לדוגמה\, בירושלים הר הזיתים מעכב את הזריחה הנראית\; חישוב זה אינו מביא זאת בחשבון.;about_hebcal_b,35,V4005015b3,106005016b5,;"Sea-level sunrise fetched from hebcal.com's public Zmanim API. Numerically equivalent to local Mishor (Hebcal does not support elevation). Useful as a cross-check or for users who prefer matching what Hebcal publishes.";about_hebcal_b,36,V4004c1312,d3004c13e1,;"זריחה בגובה פני הים מ-API ציבורי של hebcal.com. שווה מספרית למישור המקומי (Hebcal לא תומך בגובה). שימושי כבדיקה צולבת או למשתמשים שמעדיפים להתאים לערך שמפורסם ב-Hebcal.";zman_sof_zman_tefilla,35,V4000e0277,42000e02b5,;"Sof Zman Tefilla";zman_sof_zman_tefilla,36,V4000c01fe,3f000c0239,;"סוף זמן תפילה";msg_fetch_failed,35,V40023075f,440023079f,;"Could not fetch zmanim.";msg_fetch_failed,36,V40020067c,49002006c1,;"לא ניתן היה לטעון את הזמנים.";loading,35,V40008014a,2c00080172,;"Loading…";loading,36,V40007011d,2900070142,;"טוען…";zman_tzeit,35,V4001403cf,3700140402,;"Tzeit HaKochavim";zman_tzeit,36,V400120345,3200120373,;"צאת הכוכבים";title_settings,35,V400290861,3300290890,;"Settings";title_settings,36,V400250768,3100250795,;"הגדרות";about_nireh_h,35,V4004c130f,4b004c1356,;"HaNireh (sea horizon) — on device";about_nireh_h,36,V4004810e1,410048111e,;"הנראה (אופק ים) — מקומי";subtitle_at,35,V400160408,2f00160433,;"at %1$s";subtitle_at,36,V400140379,31001403a6,;"בשעה %1$s";about_intro_b,35,V400450fe1,18900451166,;"Netz HaChama (נץ החמה) is the halachic moment of sunrise. Different opinions compute it differently — based on whether the sun's center or upper limb crosses the horizon\, whether atmospheric refraction is included\, whether the observer is at sea level or elevated\, and whether the eastern horizon is the geometric sea horizon or actual local terrain.";about_intro_b,36,V400410e37,12500410f58,;"נץ החמה הוא הרגע ההלכתי של זריחה. שיטות שונות מחשבות אותו בדרכים שונות — לפי האם מרכז השמש או קצה השמש חוצים את האופק\, האם נכללת שבירה אטמוספרית\, האם הצופה בגובה פני הים או בגובה רב\, והאם האופק המזרחי הוא אופק הים הגיאומטרי או טופוגרפיה מקומית אמיתית.";hint_minutes,35,V400631c0a,3900631c3f,;"Mins before Netz";hint_minutes,36,V4005e188b,36005e18bd,;"דקות לפני הנץ";lang_english,35,V4002f09e8,30002f0a14,;"English";lang_english,36,V4002b08d3,30002b08ff,;"English";settings_in_israel,35,V4002c0911,38002c0945,;"In Israel";settings_in_israel,36,V40028080c,350028083d,;"בישראל";zman_sof_zman_shma,35,V4000d023a,3c000d0272,;"Sof Zman Shma";zman_sof_zman_shma,36,V4000b01c3,3a000b01f9,