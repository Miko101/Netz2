<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetzHahama">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.NetzHahama.Settings" />
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.NetzHahama.Settings" />
        <activity
            android:name=".ui.LocationSettingsActivity"
            android:exported="false"
            android:label="@string/settings_location_source"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.NetzHahama.Settings"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.TfilaSettingsActivity"
            android:exported="false"
            android:label="@string/title_tfila"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.NetzHahama.Settings" />
    </application>

</manifest>
